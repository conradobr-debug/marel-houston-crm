# Browser-safe variables
# These values may be included in the deployed static application's runtime configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CRM_PUBLIC_URL=http://127.0.0.1:8766
CRM_ENVIRONMENT=local
CRM_WORKSPACE_ID=10000000-0000-4000-8000-000000000001
CRM_FILES_BUCKET=marel-crm-files

# Server/CLI-only variables
# Never expose these values in frontend code, config/runtime-config.js, browser logs,
# static hosting variables, screenshots, or client-side error reports.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
# It must never be used by the Marel CRM frontend.
